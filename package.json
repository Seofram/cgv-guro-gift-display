{
  "name": "cgv-guro-gift-display",
  "version": "1.4.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.server.config.ts",
    "build": "npm run server:build",
    "test": "npm run server:check && node --test tests/item-order.test.mjs tests/server-transition.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.server.json",
    "server:build": "vite build --config vite.server.config.ts",
    "server:check": "tsc --noEmit -p tsconfig.server.json && npm run server:build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "type": "module"
}
