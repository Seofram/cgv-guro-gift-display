{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CGV 구로 경품 안내",
  "version": "1.2.2",
  "identifier": "com.seofram.cgv-guro-gift-display",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run desktop:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CGV 구로 경품 관리 · 시작 중",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
